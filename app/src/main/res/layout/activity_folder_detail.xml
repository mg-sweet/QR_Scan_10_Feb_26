<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"> <!-- ✅ Changed -->

    <!-- 1. Boxed Toolbar with Expandable Search -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/toolbarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ✅ Notch Padding တွက်ချက်ရန် ID အသစ်ပေးထားသည် -->
        <FrameLayout
            android:id="@+id/toolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"> <!-- ✅ Changed -->

            <!-- 🟢 Normal Toolbar State -->
            <RelativeLayout
                android:id="@+id/layoutNormalToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    app:tint="@color/on_surface" /> <!-- ✅ Changed -->

                <TextView
                    android:id="@+id/tvFolderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/btnBack"
                    android:text="Project Files"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" /> <!-- ✅ Changed -->

                <TextView
                    android:id="@+id/btnShareFiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_icon_rounded"
                    android:padding="10dp"
                    android:text="Select"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" /> <!-- ✅ Changed -->

                <!-- 🔍 Search Icon -->
                <ImageButton
                    android:id="@+id/btnOpenSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:layout_toStartOf="@id/btnShareFiles"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/text_secondary" /> <!-- ✅ Changed -->
            </RelativeLayout>

            <!-- 🔵 Search Toolbar State -->
            <LinearLayout
                android:id="@+id/layoutSearchToolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <!-- ⬅️ Search Mode ထဲမှ ထွက်သည့် Back ခလုတ် -->
                <ImageButton
                    android:id="@+id/btnCloseSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    app:tint="@color/text_secondary" /> <!-- ✅ Changed -->

                <EditText
                    android:id="@+id/etSearchFiles"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search sessions..."
                    android:imeOptions="actionSearch"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" /> <!-- ✅ Changed -->

                <!-- ❌ စာသားကို ရှင်းလင်းသည့် Clear (X) ခလုတ် -->
                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone"
                    app:tint="@color/text_secondary" /> <!-- ✅ Changed -->
            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        android:paddingBottom="100dp"
        android:background="@color/background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarCard" /> <!-- ✅ Changed -->

    <!-- 3. Selection Action Bar (Floating) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selectionBarCard"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"> <!-- ✅ Changed -->

        <!-- ✅ Card အတွင်းပိုင်း နောက်ခံအတွက် Surface Color သုံးထားသည် -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:background="@color/surface">

            <!-- ✅ Dark Mode တွင် Icon မြင်ရစေရန် Tint ထည့်ထားသည် -->
            <ImageButton
                android:id="@+id/btnSelectAll"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_select_all"
                app:tint="@color/on_surface" />

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="0 Selected"
                android:textColor="@color/on_surface"
                android:textStyle="bold" /> <!-- ✅ Changed -->

            <ImageButton
                android:id="@+id/btnShareSelected"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="@color/primary" /> <!-- ✅ Changed -->

            <ImageButton
                android:id="@+id/btnDownloadSelected"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_download"
                app:tint="@color/secondary" /> <!-- ✅ Changed -->

            <ImageButton
                android:id="@+id/btnDeleteSelected"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/error" /> <!-- ✅ Changed -->

            <ImageButton
                android:id="@+id/btnCloseSelection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary" /> <!-- ✅ Changed -->
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="New File"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary"
        app:layout_constraintBottom_toTopOf="@+id/adContainer"
        app:layout_constraintEnd_toEndOf="parent" /> <!-- ✅ Changed -->

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarCard">

        <ImageView android:layout_width="100dp"
            android:layout_height="100dp"
            android:alpha="0.3"
            android:src="@drawable/ic_folder_empty"
            app:tint="@color/text_secondary" /> <!-- ✅ Dark Mode တွင် အမည်းကြီးမဖြစ်စေရန် Tint ထည့်ထားသည် -->

        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No files found"
            android:textColor="@color/text_secondary" /> <!-- ✅ Changed -->
    </LinearLayout>

    <!-- ✅ 6. Ads Container (Bottom) -->
    <!-- အောက်ခြေတွင် အမြဲကပ်နေမည်ဖြစ်သည် -->
    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="55dp"
        android:background="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"> <!-- ✅ Changed background to surface -->

        <!-- တကယ့် ကြော်ငြာ Code ထည့်ရန် နေရာ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Advertisement Banner"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="italic" /> <!-- ✅ Changed -->
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>