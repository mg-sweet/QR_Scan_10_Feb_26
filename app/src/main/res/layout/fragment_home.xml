<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <!-- ✅ Changed -->

    <!-- Header Background -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_header_gradient"
        app:layout_constraintBottom_toBottomOf="@id/statsLayout"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="24dp"/>

    <!-- App Name (Kept white because of gradient background) -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="Scanner Pro"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnShareAll"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_icon_rounded"
        android:padding="10dp"
        android:src="@drawable/ic_share"
        app:layout_constraintBottom_toBottomOf="@id/tvAppName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAppName"
        app:tint="@color/primary"
        android:tooltipText="Select for Sharing"/> <!-- ✅ Changed -->

    <!-- Stats Row -->
    <LinearLayout
        android:id="@+id/statsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingBottom="15dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppName">

        <!-- Folder Stats Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">
            <!-- MaterialCardView uses ?attr/colorSurface automatically -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Folders"
                    android:textColor="@color/text_secondary" android:textSize="10sp" android:textAllCaps="true" /> <!-- ✅ Changed -->
                <TextView android:id="@+id/tvTotalFolders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" /> <!-- ✅ Changed -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- File Stats Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FILES" android:textColor="@color/text_secondary" android:textSize="10sp" android:textAllCaps="true" /> <!-- ✅ Changed -->
                <TextView android:id="@+id/tvAllScansCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/secondary" android:textSize="18sp" android:textStyle="bold" /> <!-- ✅ Changed -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Ad Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/adCard"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="13dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/text_secondary"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/statsLayout"> <!-- ✅ Changed -->

        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background"> <!-- ✅ Changed -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Advertisement Area" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="italic" /> <!-- ✅ Changed -->
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Project Header & Search Box -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/labelContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/adCard">

        <!-- Search Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/text_secondary"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/trashContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"> <!-- ✅ Changed -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:background="@color/surface"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"> <!-- ✅ Changed -->

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/text_secondary" /> <!-- ✅ Changed -->

                <EditText
                    android:id="@+id/etSearchProjects"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Search projects..."
                    android:imeOptions="actionSearch"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" /> <!-- ✅ Changed -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Trash Button Container -->
        <FrameLayout
            android:id="@+id/trashContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnOpenTrash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_rounded"
                android:padding="10dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_secondary" /> <!-- ✅ Changed -->

            <TextView
                android:id="@+id/tvTrashBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_circle"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/on_error"
                android:textSize="10sp"
                android:visibility="gone" /> <!-- ✅ Changed -->
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelContainer" />

    <!-- Empty State -->
    <LinearLayout android:id="@+id/emptyState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/adCard">
        <ImageView android:layout_width="80dp" android:layout_height="80dp" android:alpha="0.3" android:src="@drawable/ic_folder_empty" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No projects found" android:textColor="@color/text_secondary" /> <!-- ✅ Changed -->
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>